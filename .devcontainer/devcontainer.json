{
  "name": "Academy C++ Lab",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"],
      "settings": {"cmake.sourceDirectory": "${workspaceFolder}/academy-lab", "cmake.configureOnOpen": false, "editor.formatOnSave": true}
    },
    "codespaces": {"openFiles": ["academy-lab/docs.md", "academy-lab/src/exercises.cpp"]}
  },
  "postCreateCommand": "g++ --version && cmake --version"
}
